# Copy to .env and fill in to send real events. With these unset the server runs
# in dry-run mode: it builds and validates the payload, prints it, and sends
# nothing. Everything in this repo is demonstrable without a Meta account.

# Events Manager > Data sources > your pixel
META_PIXEL_ID=

# Events Manager > Settings > Conversions API > Generate access token
META_ACCESS_TOKEN=

# Events Manager > Test events. Routes events to the test view rather than
# reporting, which is how to watch deduplication work without touching a live
# campaign's numbers.
META_TEST_EVENT_CODE=

# Where retained answers are written. Defaults to ./data
PHI_STORE_DIR=

PORT=3210
